# Локальная разработка: значения совпадают с дефолтами lib/server/env-schema.ts и docker-compose.yml,
# поэтому .env.local нужен, только если что-то меняете. В production все переменные обязательны.
SITE_URL=http://localhost:3010
SITE_INDEXABLE=false
GIT_SHA=dev
# Рантайм сайта — роль recipe_app (только DML).
DATABASE_URL=postgres://recipe_app:recipe_app_dev@127.0.0.1:5434/recipe
# Только для мигратора — логин recipe_migrator (в проде лежит в отдельном файле, вебу не выдаётся).
MIGRATION_DATABASE_URL=postgres://recipe_migrator:recipe_migrator_dev@127.0.0.1:5434/recipe
# Вход владельца через Telegram-бота (план owner-login-telegram). Не заданы — вход выключен, сайт
# работает; задана часть — сервер не стартует. Настоящие значения — только на сервере (web.env).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
# OWNER_TELEGRAM_ID=
# Только для e2e: адрес заглушки Bot API (в проде не задаётся).
# TELEGRAM_API_BASE=http://127.0.0.1:3999
# ИИ-разбор рецептов (план recipe-ai-parse): Vercel AI Gateway. Без ключа — только «старый формат».
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=openai/gpt-6-luna
# Только для e2e: заглушка шлюза (в проде не задаётся).
# AI_GATEWAY_BASE_URL=http://127.0.0.1:3998/v1
